# Application
ENVIRONMENT=development
APP_PORT=443

# IP ou hostname public de la VM (certificat HTTPS + URLs app)
# Exemple : PUBLIC_HOST=203.0.113.10
PUBLIC_HOST=localhost
PUBLIC_APP_URL=http://localhost

# Logs — même arborescence hôte / conteneur
# Créer sur l'hôte : mkdir -p /var/log/running-dashboards/host-logs
HOST_LOG_DIR=/var/log/running-dashboards/host-logs
LOG_DIR=/var/log/running-dashboards/host-logs
LOG_LEVEL=INFO
LOG_FILE_NAME=api.log

# PostgreSQL
POSTGRES_USER=running
POSTGRES_PASSWORD=running
POSTGRES_DB=runningdashboard

# CORS : doit coller à l’URL du navigateur
CORS_ORIGINS=https://localhost,https://localhost:443,http://localhost,http://localhost:80,http://localhost:5173

# Strava (https://www.strava.com/settings/api)
# Authorization Callback Domain = hôte sans schéma (ex. localhost ou votre IP)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost/api/auth/strava/callback
STRAVA_SCOPES=read,activity:read_all,profile:read_all

# Session cookie (changez en production)
SESSION_SECRET=dev-change-me-runningdashboard-session
# SESSION_COOKIE_SECURE=true  # si HTTPS uniquement

# Ollama — défaut au premier démarrage (surchargeable ensuite dans UI Admin)
# Profils :
#   qwen2.5:7b   → VM ~16 Go (léger)
#   qwen2.5:14b  → VM ~32 Go (recommandé)
OLLAMA_MODEL=qwen2.5:14b
# URL interne Docker (ne pas exposer publiquement)
OLLAMA_BASE_URL=http://ollama:11434
# Timeout lecture chat (s) — 1er appel CPU 14B peut être long
OLLAMA_CHAT_TIMEOUT_S=600
# Longueur max de génération (tokens)
OLLAMA_NUM_PREDICT=650
# Garder le modèle en RAM : -1 = jamais décharger (recommandé sur VM 32 Go)
OLLAMA_KEEP_ALIVE=-1
