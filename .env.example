# Application
ENVIRONMENT=development
APP_PORT=443

# Logs — même arborescence hôte / conteneur
# Créer sur l'hôte : mkdir -p /var/log/running-dashboards/host-logs
HOST_LOG_DIR=/var/log/running-dashboards/host-logs
LOG_DIR=/var/log/running-dashboards/host-logs
LOG_LEVEL=INFO
LOG_FILE_NAME=api.log

# PostgreSQL
POSTGRES_USER=running
POSTGRES_PASSWORD=running
POSTGRES_DB=runningdashboard

# CORS : doit correspondre à l’URL ouverte dans le navigateur (HTTPS)
# Accès par IP : ajouter https://VOTRE_IP (ex. https://203.0.113.10)
CORS_ORIGINS=https://localhost,https://localhost:443,http://localhost:5173

# Ollama — défaut au premier démarrage (surchargeable ensuite dans UI Paramètres)
# Profils :
#   qwen2.5:7b   → VM ~16 Go (léger)
#   qwen2.5:14b  → VM ~32 Go (recommandé)
OLLAMA_MODEL=qwen2.5:14b
