# Application
ENVIRONMENT=development
APP_PORT=8080

# Logs (monté dans le conteneur API)
# Sur l'hôte : chemin relatif au dossier infra/ ou absolu
HOST_LOG_DIR=../logs
LOG_DIR=/var/log/running-dashboard
LOG_LEVEL=INFO
LOG_FILE_NAME=api.log

# PostgreSQL
POSTGRES_USER=running
POSTGRES_PASSWORD=running
POSTGRES_DB=runningdashboard

# CORS (dev)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Ollama — défaut au premier démarrage (surchargeable ensuite dans UI Paramètres)
# Profils :
#   qwen2.5:7b   → VM ~16 Go (léger)
#   qwen2.5:14b  → VM ~32 Go (recommandé)
OLLAMA_MODEL=qwen2.5:14b
