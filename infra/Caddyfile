(app) {
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}
}

# HTTP — toujours accessible (http://IP ou http://localhost)
:80 {
	import app
}

# HTTPS — certificat auto-signé avec SAN (IP/DNS via PUBLIC_HOST)
:443 {
	tls /data/certs/cert.pem /data/certs/key.pem
	import app
}
