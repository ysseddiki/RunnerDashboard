{
	# Certificat local (idéal sans nom de domaine / accès par IP).
	# Le navigateur affichera un avertissement à accepter une fois.
	auto_https disable_redirects
}

:443 {
	tls internal
	encode gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:80
	}
}

:80 {
	redir https://{host}{uri} permanent
}
