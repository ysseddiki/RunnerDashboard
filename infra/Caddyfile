(security_headers) {
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://www.strava.com"
		-Server
	}
}

(app) {
	encode gzip
	import security_headers

	handle /api/coach/* {
		reverse_proxy api:8000 {
			transport http {
				read_timeout 900s
				write_timeout 900s
			}
		}
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy web:8080
	}
}

# Blocs de sites générés par caddy-entrypoint.sh selon PUBLIC_HOST / TLS_MODE :
# - domaine public  → Let's Encrypt (ACME automatique) + HSTS + redirection HTTP→HTTPS
# - IP / localhost  → certificat auto-signé (Let's Encrypt ne couvre pas ces cas)
import /etc/caddy/sites.caddy
